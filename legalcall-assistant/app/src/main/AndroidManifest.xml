<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 通话状态监听（用于"接听后"自动播报） -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- 音频通道切换（听筒/外放） -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- 联网激活（服务器白名单校验） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 悬浮球 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 定时脱身（后台拉起全屏来电） -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 通知（假消息轰炸） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 短信监听（暗号触发，仅本地匹配不上传） -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- 注意：联网仅用于「匿名使用量统计」，不采集任何个人隐私（只传哈希匿名设备号） -->

    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LegalCall">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".fakecall.FakeCallActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.LegalCall" />

        <service
            android:name=".fakecall.FloatingBallService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating_ball_escape" />
        </service>

        <activity
            android:name=".fakecall.FakeShutdownActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.LegalCall" />

        <receiver
            android:name=".fakecall.AlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".fakecall.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".block.CallBlockService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
